<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- 11. dzień każdego miesiąca o 22:42. Bez klucza Weekday — sobota, niedziela
     i święto też. Cena za poprzedni miesiąc; skrypt odświeża też korekty z 12 miesięcy. -->
<dict>
  <key>Label</key>
  <string>pl.smart-energy-model.rcem</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>__PROJECT_ROOT__/mlops/fetch_rcem.sh >> __PROJECT_ROOT__/logs/cron.log 2>&1</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key>
    <integer>11</integer>
    <key>Hour</key>
    <integer>22</integer>
    <key>Minute</key>
    <integer>42</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/logs/launchd-rcem.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/logs/launchd-rcem.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
