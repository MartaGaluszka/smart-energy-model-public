<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>pl.smart-energy-model.evening-battery-stop</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>__PROJECT_ROOT__/mlops/evening_battery_stop.sh >> __PROJECT_ROOT__/logs/cron.log 2>&1</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/logs/launchd-evening-battery-stop.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/logs/launchd-evening-battery-stop.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
