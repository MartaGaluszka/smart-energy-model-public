# FoxEss Cloud Open API (private token)
# Wygeneruj klucz: portal V1 → User Profile → API Management
# https://www.foxesscloud.com/public/i18n/en/OpenApiDocument.html
FOXESS_API_KEY=your_foxess_api_key_here

# Po limicie 40402: wyłącz sync na ~24h (pogoda/prognoza OK; Fox = plant CSV)
# FOXESS_SYNC_DISABLED=1
# Fail-fast przy limicie (domyślnie 2; unikaj 10× retry przedłużających blokadę)
# FOXESS_MAX_RETRIES=2

# Numer seryjny falownika — przy limicie API (40402) skrypt używa cache z bazy
# FOXESS_DEVICE_SN=YOUR_DEVICE_SN

# Opóźnienie między dniami przy pobieraniu (sekundy)
# FOXESS_API_DELAY_SEC=2
# FOXESS_PAUSE_EVERY_N_DAYS=10
# FOXESS_PAUSE_SEC=45

# Wieczorne domknięcie dnia (mlops/evening_closeout_dynamic.sh, launchd co 10 min):
# ile minut po zachodzie słońca (astral, WEATHER_LAT/LON) uznajemy dzień za zamknięty.
# 30 min = bufor na resztkową produkcję o zmierzchu + opóźnienie sync FoxESS.
# EVENING_CLOSEOUT_MARGIN_MINUTES=30

DATA_SOURCE=api
FOXESS_START_DATE=2025-05-01
# FOXESS_START_DATE=2025-04-01
FOXESS_FETCH_ALL=1
DATABASE_PATH=data/energy_model.db
# Model produkcyjny RF (domyślnie models/pv_hourly_model.joblib)
# PV_HOURLY_MODEL_PATH=models/pv_hourly_model.joblib
LOG_LEVEL=INFO

# Open-Meteo — współrzędne instalacji PV (bez adresu w repozytorium)
# WEATHER_LAT=50.06
# WEATHER_LON=19.94
# WEATHER_LOCATION=home
# WEATHER_START_DATE=2025-04-21
# WEATHER_END_DATE=2026-04-30
# WEATHER_FORECAST_DAYS=3
# Model: best_match (domyślny) | icon_seamless (produkcja) | ukmo_seamless (TYLKO testy oneshot)
# OPENMETEO_MODEL=icon_seamless
# Testy UKMO: ./scripts/analysis/run_ukmo_tests.sh  (nie zmienia .env produkcji)

# Ensemble NWP (ICON+UKMO) — NIE ustawiaj =1 w prod sync (nadpisałoby zapis prognozy).
# Shadow live: FORECAST_ENSEMBLE_SHADOW=1 → mlops/forecast_ensemble_shadow.sh
#   (osobny data_source + pv_forecast_ensemble.csv; primary zostaje ICON).
# WEATHER_ENSEMBLE_UKMO=0
# FORECAST_ENSEMBLE_SHADOW=1

# Dual produkcja: 16 cech (primary) + CS4 (19) w tym samym launchd
# FORECAST_CS4_ENABLED=1
# PV_HOURLY_MODEL_CS4_PATH=models/pv_hourly_model_cs4.joblib
# Wyłączenie CS4: FORECAST_CS4_ENABLED=0
# (alias wsteczny: FORECAST_CS4_SHADOW)

# Target godzinowy ML (= closeout): pve = ΔPVEnergyTotal (ta sama zmienna co w app FoxESS).
# pvpower = stary surowy ∫pvPower (~+10–15%). Alias historyczny: PV_HOURLY_TARGET_SCALE=app → pve.
# PV_HOURLY_TARGET=pve

# Instalacja PV + magazyn (dokumentacja / advisor; baseline fizyczny: kWp × PR)
# PV_SYSTEM_KWP=5.39
# PV_PANEL_COUNT=11
# BATTERY_CAPACITY_KWH=10.36

# Geometria paneli (src/features/panel_geometry.py) — eksperyment PO tygodniu obserwacji
# Domyślnie WYŁĄCZONE — nie zmienia modelu produkcyjnego (16 cech).
# PANEL_GEOMETRY_FEATURES=0
# PANEL_TILT_DEG=35            # kąt dachu (~70% nachylenia)
# PANEL_AZIMUTH_DEG=180        # 180=południe (0=N, 90=E, 180=S, 270=W)
# Preview: python scripts/analysis/preview_panel_geometry.py --day 2026-07-17
# IMGW — najbliższa stacja klimat (opcjonalnie wymuś kod stacji)
# IMGW_START_DATE=2025-09-01
# IMGW_END_DATE=2026-02-28
# IMGW_STATION_CODE=250190390
# Walidacja obserwacji pogodowych (validate_snow_photos.py) — tylko opisy tekstowe, bez zdjęć w repo
# SNOW_USE_MELT_MODEL=1  # model topnienia zamiast reguły 7d/3°C (src/features/snow_melt_model.py)
# SNOW_MELT_CSV=data/processed/snow_melt_comparison.csv
# PHOTO_VALIDATION_CSV=data/processed/photo_validation.csv
# CALIBRATION_CSV=data/processed/calibration_photo_days.csv
# ML_TRAIN_START=auto           # auto: expanding → rolling 24m
# ML_TRAIN_END=auto             # wczoraj lub ostatni dzień FoxESS w bazie
# ML_TRAIN_MIN_START=2025-06-01 # twardy start (expanding)
# ML_TRAIN_ROLLING_AFTER_MONTHS=24  # po tylu mies. przełącz na rolling
# ML_TRAIN_MONTHS=24            # długość okna rolling (nie 12)
# ML_TEST_START=2026-02-01   # tylko legacy / PVHourlyPredictor.train() — produkcja: shuffle 80/20
# ML_RESULTS_CSV=data/processed/model_comparison.csv
# Logika śniegu na panelach (dzienna): okno [dni] + próg odwilży [°C]
# SNOW_WINDOW_DAYS=7
# SNOW_THAW_TEMP_C=3.0
# SNOW_AUTO_CALIBRATE=0
# FOG_REPORT_CSV=data/processed/fog_days_report.csv
# SNOW_SENSITIVITY_PNG=reports/figures/snow_panel_sensitivity.png

# Bateria — advisor zimowy (src/optimization/battery_advisor.py)
# BATTERY_CAPACITY_KWH=10.36
# BATTERY_SOC_TARGET=80
# BATTERY_SOC_MIN_EVENING=50
# Rezerwa sezonowa = UI soc_min przy season=auto (BAT.5 / B1 / §D–E):
# zima XI–II = 40 / jesień 15.09–31.10 = 22 / wiosna III–V = 20 / lato = 20
# BATTERY_SOC_RESERVE_WINTER=40
# BATTERY_SOC_RESERVE_AUTUMN=22
# BATTERY_SOC_RESERVE_SUMMER=20
# BATTERY_SOC_MIN_EVENING_AUTUMN=45
# season=auto|summer|autumn|spring|winter
# Jesień FC: PV jutro < 8 (§D); wiosna: SoC<40 i PV<8 (§E)
# BATTERY_AUTUMN_PV_CHARGE_KWH=8
# BATTERY_AUTUMN_TARGET_SOC=85
# BATTERY_SPRING_TOMORROW_MAX_KWH=8
# BATTERY_SPRING_SOC_CHARGE_BELOW=40
# Zima FC 13–15 (historia XI–II): SoC<40 i T≤5 i PV<10
# BATTERY_WINTER_AFT_SOC_BELOW=40
# BATTERY_WINTER_AFT_PV_BELOW=10
# BATTERY_WINTER_AFT_TEMP_BELOW=5
# Lato: krótki FC gdy SoC < 20% — max 15 min / +25 pp (lekcja 25–26.08, nie pełnić do 75%)
# BATTERY_SUMMER_FC_MAX_MINUTES=15
# BATTERY_SUMMER_FC_DELTA_SOC=25
# BATTERY_SUMMER_TOMORROW_MAX_KWH=10
# Reguła apki zimą/jesienią (B2): Tśr jutro + PV → cel SoC i minuty (30 min ≈ +50 pp)
# BATTERY_B2_PV_SKIP_KWH=12
# BATTERY_B2_MILD_WEAK_PV_KWH=8
# BATTERY_FC_MINUTES_PER_50_SOC=30
# BATTERY_FC_SOC_PER_30_MIN=50
# Pomiń drobne doładowanie (cykl LFP vs spread G12w ~0,36 zł/kWh)
# BATTERY_FC_MIN_WORTH_KWH=2
# BATTERY_FC_MIN_DELTA_SOC=15
# BATTERY_TARIFF_SPREAD_PLN_PER_KWH=0.36
# BATTERY_CYCLE_COST_PLN_PER_KWH=0.30
# Stary próg „pochmurno” (zastąpiony B2; zostawiony dla kompatybilności)
# BATTERY_SOC_CHARGE_TONIGHT_BELOW=50
# BATTERY_CLOUDY_DAY_PV_KWH=18
# BATTERY_HIGH_LOAD_KW=2.0
# BATTERY_OUTAGE_GRID_KW=0.2
# BATTERY_OUTAGE_PLANNING_LOAD_KW=2.5

# Sterowanie baterią FoxESS (src/data/foxess_control.py, mlops/foxess_control.py)
# Domyślnie WYŁĄCZONE — najpierw obserwuj logi dry-run przez kilka dni.
# BATTERY_CONTROL_ENABLED=0
# BATTERY_CONTROL_APPLY=0
# Okna ForceCharge (G12w, dni robocze) — domyślnie 22–6 i 13–15 w battery_control.py

# Analiza serii pochmurnych (scripts/analysis/analyze_cloudy_streaks.py)
# CLOUDY_STREAK_START=2025-06-01
# CLOUDY_STREAK_LOW_PV_KWH=10

# =============================================================================
# FastAPI backend (api/) + Docker Compose — Faza 0 aplikacji mobilnej
# Patrz: docs/PROJEKT_APLIKACJA_MOBILNA.md §12, docs/ZADANIA_IMPLEMENTACJA_MOBILNA.md
# =============================================================================

# SQLAlchemy connection string dla NOWYCH tabel appki (auth, notifications, ROI...).
# Lokalnie (bez Dockera) domyślnie ten sam plik SQLite co DATABASE_PATH powyżej —
# api/db.py tworzy w nim brakujące tabele (create_all) obok istniejących FoxESS/weather.
# W Dockerze (docker-compose.yml) nadpisywane na Postgres 16.
# DATABASE_URL=sqlite:///./data/energy_model.db
# DATABASE_URL=postgresql+psycopg2://smart_energy:smart_energy_dev_password@localhost:5432/smart_energy

# Postgres (tylko dla docker-compose `db`) — NIE prawdziwe hasło produkcyjne.
# POSTGRES_DB=smart_energy
# POSTGRES_USER=smart_energy
# POSTGRES_PASSWORD=change-me-in-prod
# POSTGRES_PORT=5432
# API_PORT=8000

# Sekret do podpisywania JWT (access + refresh). WYGENERUJ własny w .env, np.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=change-me-dev-only-not-for-production
# JWT_ACCESS_TOKEN_MINUTES=30
# JWT_REFRESH_TOKEN_DAYS=7

# Klucz Fernet do szyfrowania API-key FoxESS w user_secrets (at-rest). WYGENERUJ:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Bez tego ustawienia api/config.py wygeneruje klucz efemeryczny przy starcie procesu
# (OK do lokalnego dev/testów — NIE nadaje się do produkcji, bo znika przy restarcie).
# SECRETS_ENCRYPTION_KEY=

# CORS — lista originów oddzielona przecinkami; dev Ionic (localhost/LAN) + Capacitor.
# CORS_ORIGINS=http://localhost:8100,http://localhost,capacitor://localhost,ionic://localhost

# Ścieżka modelu joblib używana przez api/ (ładowany raz w lifespan do app.state).
# PV_HOURLY_MODEL_PATH=models/pv_hourly_model.joblib

# Prognoza PV — korekta operacyjna (własny algorytm intraday, bez zewn. pluginów)
# Domyślnie wyłączona (0): tabela/historia = raw RF. Włącz po decyzji D8 / symulacji.
# Przy ADJUST=1 działa Conditional Adjust: skala+cloudy tylko gdy
#   |actual/raw−1| > FORECAST_ADJUST_ERROR_THRESHOLD  LUB  cloud_avg ≥ THRESHOLD
# Skala/cloudy tylko D+0 (nie D+1/D+2). Hybryda FoxESS niezależna.
FORECAST_OPERATIONAL_ADJUST=0
# FORECAST_INTRADAY_MIN_HOURS=2
# FORECAST_INTRADAY_MIN_FORECAST_KWH=0.5
# FORECAST_INTRADAY_BLEND=0.50
# FORECAST_ADJUST_ERROR_THRESHOLD=0.15
# FORECAST_SCALE_MIN=0.25
# FORECAST_SCALE_MAX=1.5
# FORECAST_CLOUDY_THRESHOLD_PCT=70
# FORECAST_CLOUDY_EXTRA_SCALE=0.80
# FORECAST_CONSERVATIVE_MARGIN=0.85
# FORECAST_CLOUDY_CONSERVATIVE_MARGIN=0.75
# FORECAST_ERROR_MIN_SAMPLES=3
# FORECAST_ERROR_PROFILE_PATH=data/processed/forecast_error_profile.csv
