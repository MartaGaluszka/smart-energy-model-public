# Skopiuj do deploy/oci/.env na VM (NIGDY nie commituj .env).
# cp deploy/oci/.env.example deploy/oci/.env

# --- Publiczny host (nip.io) ---
# Publiczne IPv4 VM, kropki → myślniki, np. 130.61.12.34 → 130-61-12-34.nip.io
PUBLIC_HOST=130-61-12-34.nip.io

# --- Postgres (compose nadpisuje DATABASE_URL w kontenerze api) ---
POSTGRES_DB=smart_energy
POSTGRES_USER=smart_energy
POSTGRES_PASSWORD=change-me-strong-postgres-password

# --- JWT / sekrety appki ---
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-strong-jwt-secret
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# CORS — Capacitor + ewentualnie web. Origin HTTPS nip.io nie jest potrzebny
# do samego API z natywnej apki (Origin = capacitor://localhost).
CORS_ORIGINS=capacitor://localhost,ionic://localhost,http://localhost,http://127.0.0.1,http://localhost:8100,http://127.0.0.1:8100

# --- Dane domenowe (FoxESS / pogoda) — tylko na VM, nie w publicznym repo ---
FOXESS_API_KEY=
# FOXESS_DEVICE_SN=
DATABASE_PATH=data/energy_model.db
PV_HOURLY_MODEL_PATH=models/pv_hourly_model.joblib
DATA_SOURCE=api
TZ=Europe/Warsaw

# Współrzędne instalacji — tylko w .env na VM (nie commituj precyzyjnego GPS).
# WEATHER_LAT=
# WEATHER_LON=
# WEATHER_LOCATION=home
# OPENMETEO_MODEL=icon_seamless

LOG_LEVEL=INFO
